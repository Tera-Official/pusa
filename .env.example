# Supabase — use the Pusa project URL and publishable/anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment provider credentials — add only after provider selection
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email provider — choose one after sender-domain verification
EMAIL_PROVIDER=
EMAIL_FROM=
